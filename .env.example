# Copie este arquivo para .env e rode "sail artisan key:generate".
# Os valores abaixo já funcionam com o Sail; ajuste só o que precisar.

# Identidade da aplicação. APP_KEY é gerado pelo key:generate.
# APP_DEBUG=true mostra a tela de erro detalhada (use false em produção).
APP_NAME="Workshop Laravel UFLA"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# Idioma. LOCALE é a língua da interface; FAKER_LOCALE gera dados de teste em pt-BR.
APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_BR

# APP_MAINTENANCE_DRIVER: onde guardar o estado do "modo manutenção".
# BCRYPT_ROUNDS: custo do hash de senha; mais alto = mais seguro e mais lento.
APP_MAINTENANCE_DRIVER=file
PHP_CLI_SERVER_WORKERS=4
BCRYPT_ROUNDS=12

# Logs. LOG_LEVEL=debug mostra tudo em desenvolvimento.
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# Banco de dados: Postgres do Sail, já pronto.
# Para rodar sem container, troque por: DB_CONNECTION=sqlite (e apague as linhas abaixo).
DB_CONNECTION=pgsql
DB_HOST=pgsql
DB_PORT=5432
DB_DATABASE=workshop
DB_USERNAME=sail
DB_PASSWORD=password

# Sessão do usuário guardada no banco.
SESSION_DRIVER=database
SESSION_LIFETIME=120

# Broadcast: canal de eventos em tempo real (log basta em dev).
# FILESYSTEM_DISK: onde os arquivos ficam. "local" = pasta storage/app;
#   troque para "s3" para usar o MinIO configurado mais abaixo.
# QUEUE_CONNECTION: fila de jobs. "database" não exige nada extra;
#   "redis" é o padrão com o Horizon.
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

# Cache no banco e Redis do Sail (host "redis" é o nome do container).
CACHE_STORE=database
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379

# E-mail. "log" só escreve no log; o Sail também sobe o Mailpit em http://localhost:8025.
MAIL_MAILER=log
MAIL_FROM_ADDRESS="workshop@example.test"
MAIL_FROM_NAME="${APP_NAME}"

# Storage S3 / MinIO. O Sail sobe um MinIO local e o serviço miniomc cria o
# bucket "local" e libera leitura pública sozinho. Para usar de verdade, ponha
# FILESYSTEM_DISK=s3 acima. Console web em http://localhost:8900.
#   AWS_ENDPOINT: endereço interno do container (a app fala com "minio").
#   AWS_USE_PATH_STYLE_ENDPOINT=true: exigido pelo MinIO.
#   AWS_URL: endereço público dos arquivos, aberto pelo navegador.
AWS_ACCESS_KEY_ID=sail
AWS_SECRET_ACCESS_KEY=password
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=local
AWS_ENDPOINT=http://minio:9000
AWS_USE_PATH_STYLE_ENDPOINT=true
AWS_URL=http://localhost:9000/local
# Credenciais root do container MinIO (batem com as AWS_* acima).
MINIO_ROOT_USER=sail
MINIO_ROOT_PASSWORD=password

# Nome exposto ao frontend (Vite) durante o build.
VITE_APP_NAME="${APP_NAME}"

# Observabilidade: Telescope registra requisições e queries; Pulse mostra
# saúde da aplicação. Ambos ligados em dev.
TELESCOPE_ENABLED=true
PULSE_ENABLED=true

# Sentry: monitoramento de erros. Deixe o DSN vazio para desligar.
SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

# Alertas por Telegram. Preencha só se for usar. Ver docs/monitoramento/README.md.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Servidor do Octane em produção (FrankenPHP). Em dev o Sail usa o servidor padrão.
OCTANE_SERVER=frankenphp
