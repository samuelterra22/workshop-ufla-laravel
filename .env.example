APP_NAME="Workshop Laravel UFLA"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file
PHP_CLI_SERVER_WORKERS=4
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# Postgres do Sail, pronto para uso. Para rodar sem container, troque por sqlite.
DB_CONNECTION=pgsql
DB_HOST=pgsql
DB_PORT=5432
DB_DATABASE=workshop
DB_USERNAME=sail
DB_PASSWORD=password

SESSION_DRIVER=database
SESSION_LIFETIME=120

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_FROM_ADDRESS="workshop@example.test"
MAIL_FROM_NAME="${APP_NAME}"

# Storage S3/MinIO. O Sail sobe o MinIO e cria o bucket sozinho.
# Para guardar arquivos nele, use FILESYSTEM_DISK=s3 acima.
AWS_ACCESS_KEY_ID=sail
AWS_SECRET_ACCESS_KEY=password
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=local
AWS_ENDPOINT=http://minio:9000
AWS_USE_PATH_STYLE_ENDPOINT=true
AWS_URL=http://localhost:9000/local
MINIO_ROOT_USER=sail
MINIO_ROOT_PASSWORD=password

VITE_APP_NAME="${APP_NAME}"

TELESCOPE_ENABLED=true
PULSE_ENABLED=true

SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

# Ver docs/monitoramento/README.md
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

OCTANE_SERVER=frankenphp
